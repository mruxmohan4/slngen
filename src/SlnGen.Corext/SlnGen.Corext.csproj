<Project Sdk="Microsoft.Build.NoTargets/3.7.134">
  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <ArtifactsPath>$(BaseArtifactsPath)\$(MSBuildProjectName)</ArtifactsPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>CoreXT Solution Generator</Title>
    <PackageDescription>CoreXT wrapper around SlnGen (https://github.com/microsoft/slngen)</PackageDescription>
    <PackageTags>slngen sln vsmsbuild</PackageTags>
    <IsTool>true</IsTool>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- SlnGen.Corext is a NoTargets net472 packaging project that only
         repacks the SlnGen output and does not compile code. The NoTargets
         SDK suppresses GetReferenceAssemblyPaths, so RAR has no targeting
         pack directories to resolve against. Suppress the implicit
         framework references (System, System.Core, etc.) added by the
         .NET SDK for net472. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);GetMyPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.VisualStudio.SlnGen\Microsoft.VisualStudio.SlnGen.csproj"
                      Private="false"
                      OutputItemType="SlnGenOutputGroup" />
  </ItemGroup>
  <!--
    Transitive NuGet packages (System.Numerics.Vectors, System.Runtime.CompilerServices.Unsafe,
    etc.) flow through the ProjectReference above and declare net472 framework references
    (System.Numerics, mscorlib) via their nuspec frameworkAssembly entries. NuGet's
    ResolveLockFileReferences target adds those to @(Reference) with
    NuGetIsFrameworkReference=true, and then ResolveAssemblyReferences fails with MSB3245
    because the NoTargets SDK suppresses GetReferenceAssemblyPaths and there are no
    TargetFrameworkDirectories to resolve them against. Strip them before RAR runs since
    this packaging-only project never compiles managed code.
  -->
  <Target Name="_RemoveTransitiveFrameworkReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.NuGetIsFrameworkReference)' == 'true'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="SlnGen.cmd"
          Pack="true"
          PackagePath="\" />
    <None Include="SlnGen.Corext.cxspec"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
  <Target Name="GetMyPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="%(SlnGenOutputGroup.RootDir)%(SlnGenOutputGroup.Directory)*"
                              Exclude="%(SlnGenOutputGroup.RootDir)%(SlnGenOutputGroup.Directory)*.pdb"
                              Pack="true"
                              PackagePath="\tools\$(TargetFramework)" />
    </ItemGroup>
  </Target>
</Project>
